{
  "name": "business-card",
  "version": "3.2.4",
  "description": "Yevhen Fabizhevskyi's personal website.",
  "homepage": "https://fabasoad.github.io/business-card/",
  "scripts": {
    "build:dev": "vite build --mode development",
    "build:prod": "vite build",
    "lint": "biome lint --write src",
    "start:dev": "vite",
    "start:web": "PUBLIC_PATH=../dist nodemon --watch ./server server/app.js",
    "test": "vitest run --coverage --reporter=json --outputFile=vitest-report.json",
    "clean": "rm -rf coverage && rm -rf temp",
    "clean:unsafe": "rm -f pnpm-lock.yaml && rm -rf node_modules"
  },
  "bugs": {
    "url": "https://github.com/fabasoad/business-card/issues",
    "email": "fabasoad@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabasoad/business-card.git"
  },
  "author": {
    "name": "Yevhen Fabizhevskyi",
    "email": "fabasoad@gmail.com",
    "url": "https://github.com/fabasoad"
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "~2.6.7",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "~5.1.0",
    "bootstrap": "~5.3.9",
    "express": "~5.3.0",
    "express-rate-limit": "~8.7.4",
    "humanize-duration": "~3.35.1",
    "i18next": "~27.1.1",
    "jsdom": "~31.0.0",
    "nodemon": "~3.1.14",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~18.0.1",
    "sass": "~1.108.2",
    "typescript": "~7.0.2",
    "vite": "~8.3.8",
    "vitest": "~5.1.0"
  },
  "dependencies": {
    "@octokit/rest": "~22.0.1",
    "@tanstack/react-query": "~5.107.1",
    "posthog-js": "~1.447.15",
    "react-bootstrap": "~2.10.10"
  },
  "packageManager": "pnpm@12.18.0"
